rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function host(){return signed() && request.auth.token.email == 'host@mindmatch.live' && request.auth.token.firebase.sign_in_provider == 'password';}
  function owner(id){return host() && get(/databases/$(database)/documents/rooms/$(id)).data.owner == request.auth.uid;}
  function room(id){return get(/databases/$(database)/documents/rooms/$(id)).data;}
  function participant(id){return signed() && exists(/databases/$(database)/documents/rooms/$(id)/entries/$(request.auth.uid));}
  match /config/live {
   allow get: if signed();
   allow list: if false;
   allow create,update: if host() && request.resource.data.roomId is string && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)) && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.owner == request.auth.uid;
   allow delete: if false;
  }
  match /rooms/{id} {
   allow get: if signed();
   allow list: if false;
   allow create: if host() && request.resource.data.owner == request.auth.uid && request.resource.data.status == 'lobby';
   allow update: if (owner(id) && request.resource.data.owner == resource.data.owner) || (signed() && request.auth.token.firebase.sign_in_provider == 'anonymous' && resource.data.status == 'lobby' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']) && resource.data.participantCount is int && resource.data.participantCount >= 0 && request.resource.data.participantCount == resource.data.participantCount + 1 && !exists(/databases/$(database)/documents/rooms/$(id)/entries/$(request.auth.uid)) && getAfter(/databases/$(database)/documents/rooms/$(id)/entries/$(request.auth.uid)).data.uid == request.auth.uid) || (participant(id) && request.auth.token.firebase.sign_in_provider == 'anonymous' && resource.data.status == 'question' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']) && request.resource.data.responseCount == resource.data.responseCount + 1 && !exists(/databases/$(database)/documents/rooms/$(id)/votes/$(string(resource.data.current) + '_' + request.auth.uid)) && getAfter(/databases/$(database)/documents/rooms/$(id)/votes/$(string(resource.data.current) + '_' + request.auth.uid)).data.uid == request.auth.uid);
   allow delete: if false;
   match /entries/{uid} {
    allow get: if owner(id) || (signed() && uid == request.auth.uid);
    allow list: if owner(id);
    allow create: if signed() && request.auth.token.firebase.sign_in_provider == 'anonymous' && uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20 && room(id).status == 'lobby' && getAfter(/databases/$(database)/documents/rooms/$(id)).data.participantCount == room(id).participantCount + 1;
    allow update,delete: if false;
   }
   match /votes/{voteId} {
    allow get,list: if owner(id) || (participant(id) && resource.data.uid == request.auth.uid);
    allow create: if participant(id) && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.data.uid == request.auth.uid && request.resource.data.question is int && request.resource.data.question >= 0 && request.resource.data.question < room(id).count && request.resource.data.choice in [0,1] && voteId == string(request.resource.data.question) + '_' + request.auth.uid && room(id).status == 'question' && room(id).current == request.resource.data.question && getAfter(/databases/$(database)/documents/rooms/$(id)).data.responseCount == room(id).responseCount + 1;
    allow update,delete: if false;
   }
  }
 }
}